# Copy to .env in each subproject that needs it (phase0_prototype/, livekit-agent/, backend/).
# Never commit the real .env file.

# --- Sarvam AI ---------------------------------------------------------
# https://dashboard.sarvam.ai -> API Keys
SARVAM_API_KEY=

# Voice / model knobs — optional. These ARE the defaults already baked into the
# code; listed here so switching is a one-line edit, not a code change. Every
# component (phase0 prototype, LiveKit agent, TTS plugin) reads these.
SARVAM_TTS_SPEAKER=shubh
# STT: "unknown" = auto-detect. Measured identical accuracy to naming the language,
# and fixes English/Punjabi/Bengali/Kannada/Malayalam/Odia which a fixed hi-IN mangles.
SARVAM_STT_LANGUAGE_CODE=unknown
# TTS: must name a real language (Bulbul rejects "unknown"). Harmless - Bulbul is
# script-driven, so hi-IN voices Telugu/Tamil/Bengali text correctly anyway.
SARVAM_TTS_LANGUAGE_CODE=hi-IN
# Legacy single knob - still read by phase0_prototype/local_prototype.py.
SARVAM_LANGUAGE_CODE=hi-IN
SARVAM_LLM_MODEL=sarvam-105b-conversations

# --- LiveKit -------------------------------------------------------------
# Local dev (docker-compose in livekit-agent/): use the devkey/secret below,
# which MUST match livekit-agent/docker-compose.yml. Never use these in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For LiveKit Cloud instead of self-hosted, replace the three LIVEKIT_* values
# with the ones from your LiveKit Cloud project settings (wss://<project>.livekit.cloud).

# --- Optional: Groq fallback LLM (see roadmap Phase 1) ------------------
GROQ_API_KEY=

# --- Optional: OpenRouter LLM (swaps ONLY the LLM leg; STT/TTS stay on Sarvam) --
# Flip to true to use it. Key from https://openrouter.ai/keys -> Create API Key.
USE_OPENROUTER=false
OPENROUTER_API_KEY=
# Any model slug from openrouter.ai/models. Tool calling is REQUIRED - the agent
# fills the indent through upsert_indent, so a model without tools cannot work.
OPENROUTER_MODEL=stealth/ox-alpha
# Optional analytics headers (HTTP-Referer / X-Title), only for OpenRouter's
# leaderboards. Leave blank to send neither.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- Token backend ---------------------------------------------------------
TOKEN_SERVER_PORT=8080
